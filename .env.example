PORT=4000

# Local: deixe vazio para o projeto subir um MongoDB só dele.
# Render: obrigatório. Use a URI do MongoDB Atlas.
# MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/controle-emprestimos

# Local: se ficar vazio, o painel abre sem login.
# Render: coloque o e-mail e a senha do seu colega.
# AUTH_EMAIL=colega@email.com
# AUTH_PASSWORD=senha-que-ele-mandou
# SESSION_SECRET=uma-frase-longa-e-aleatoria
